# Backend
NAVIMED_ENV=development
NAVIMED_DATABASE_URL=postgresql+psycopg://navimed:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/navimed
NAVIMED_APP_TIMEZONE=Asia/Damascus
NAVIMED_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NAVIMED_SUPABASE_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
NAVIMED_SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
NAVIMED_SUPABASE_JWT_AUDIENCE=authenticated
NAVIMED_MESSAGING_ENABLED=false
NAVIMED_CORS_ORIGINS=http://localhost:3000

# CHANGE_ME_LOCAL_PASSWORD is a placeholder only; never commit real credentials.

# Optional local Docker Compose password (never commit the populated .env file).
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
